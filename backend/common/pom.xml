<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
          <groupId>com.github.gaohongf</groupId>
          <artifactId>oanm</artifactId>
          <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>com.github.gaohongf</groupId>
    <artifactId>common</artifactId>
    <version>${parent.version}</version>
    <dependencies>
        <dependency>
            <groupId>com.lingyun</groupId>
            <artifactId>rsm-mvc-spring-boot-starter</artifactId>
            <version>${lingyun.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>
        <!--
          说明: Jackson / Servlet 之前全靠 rsm-mvc-spring-boot-starter 传递进来, 这里显式声明。
          序列化模块 (ResolveAutoConfiguration) 直接依赖 ObjectMapper 与
          Jackson2ObjectMapperBuilderCustomizer, 不应该依赖"恰好有人传递了 jackson"。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- 服务间调用: @User 的解析需要回源到 service-auth -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!--
          端点自注册: 各服务启动时把自己需要权限的端点上报给 service-auth。
          用 Kafka 而不是直接调 HTTP, 是因为上报"丢不起" —— 漏一个端点, 那个端点就
          永远没有权限行, 任何角色都无法被授予它, 而现象只是所有人都 403。
          Kafka 能容忍 service-auth 当时不在（消息留在 broker 上, 等它起来再消费）。

          放在 common 而不是各服务: 每个服务都要上报, 而且 service-auth 自己要用同一套
          扫描逻辑（它的登记走本地实现, 不经 Kafka —— 见 LocalEndpointRegistration）。
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- 解析结果的进程内一级缓存 (L1), 版本由 spring-boot-dependencies BOM 管理 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector.version}</version>
            <scope>compile</scope>
        </dependency>

        <!--
          说明: 引入完整 starter 而非 sa-token-core, 是为了让 StpUtil 在所有引用 common 的
          模块中都有可用的 SaTokenContext (否则运行时取登录态会失败)。

          common 只服务于业务模块 (service-*), 这些模块都是 Spring MVC 应用, 与本 starter 的
          Servlet 体系一致。api-gateway 不含业务代码、不依赖 common, 如它自身需要 sa-token,
          由该模块自行引入 sa-token-reactor-spring-boot3-starter。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-reactor-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
            <optional>true</optional>
        </dependency>
        <!--
          sa-token 的会话存储必须放在 common 而不是各服务各自声明。

          默认的 SaTokenDao 是内存实现, 只认本进程签发的 token。如果只有 service-auth 装了
          Redis 实现, 那么 service-auth 登录拿到的 token 到了 service-work-order 里就是
          "不认识的 token" —— StpUtil.getLoginId() 返回 null, 每个请求都 401。
          各服务自校验这条路从根上就不成立。

          另外这个 starter 只是把 SaTokenDao 换成 RedisTemplate 实现, 它本身不提供
          Redis 连接; 连接由 spring-boot-starter-data-redis 提供 (父 pom 已全局声明)。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- sa-token-redis-template 用 RedisTemplate 时需要连接池 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
    </dependencies>
    <properties>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
    </properties>

</project>