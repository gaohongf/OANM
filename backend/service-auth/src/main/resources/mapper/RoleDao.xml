<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.github.gaohongf.auth.dao.RoleDao">

    <!-- 说明: roles 表的基础 CRUD 由 BaseMapper 提供, 此处只写自定义查询 -->

    <select id="selectPermissionsByRoleName" resultType="com.github.gaohongf.auth.entity.po.PermissionEntity">
        SELECT p.*
        FROM role_permissions rp
                 INNER JOIN permissions p ON p.id = rp.permission_id
            AND p.deleted = 0
        WHERE rp.role_name = #{roleName}
          AND rp.deleted = 0
        ORDER BY p.permission_key
    </select>

</mapper>
